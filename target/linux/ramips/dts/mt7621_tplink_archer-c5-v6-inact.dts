// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * TP-Link Archer C5 v6, INACT variant.
 *
 * 128 MB of parallel NAND behind NMBM, with the same vendor flash layout
 * as tplink,ex220-v1-nand. The vendor firmware keeps the radio calibration
 * and MAC addresses as files in the JFFS2 misc_ro partition; mt7603 and
 * mt7615 can only read them from raw flash, so the 99_migrate_jesse_calibration
 * uci-defaults script copies them once into the factory partition below.
 */

#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "tplink,archer-c5-v6-inact", "mediatek,mt7621-soc";
	model = "TP-Link Archer C5 v6 (INACT)";

	aliases {
		label-mac-device = &gmac0;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	/*
	 * The bootloader replaces bootargs with its own, including
	 * ubi.mtd=misc_isp, which stops the kernel from attaching "ubi".
	 */
	chosen {
		bootargs-override = "console=ttyS0,115200n8";
	};

	keys {
		compatible = "gpio-keys";

		button-wps {
			label = "wps";
			gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
			linux,code = <KEY_WPS_BUTTON>;
		};

		button-reset {
			label = "reset";
			gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-power {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio 4 GPIO_ACTIVE_LOW>;
		};

		led-wan-amber {
			color = <LED_COLOR_ID_AMBER>;
			function = LED_FUNCTION_WAN;
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
		};

		led-lan {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
		};

		led-wifi5g {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			function-enumerator = <5>;
			gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy1tpt";
		};

		led-wifi2g {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			function-enumerator = <2>;
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};

		led-wan-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&gpio 45 GPIO_ACTIVE_LOW>;
		};
	};
};

&nand {
	status = "okay";

	mediatek,nmbm;
	mediatek,bmt-remap-range = <0x0 0x7800000>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "boot";
			reg = <0x0 0x80000>;
			read-only;
		};

		partition@80000 {
			label = "boot_env";
			reg = <0x80000 0x80000>;
		};

		partition@100000 {
			label = "misc_ro";
			reg = <0x100000 0x600000>;
			read-only;
		};

		partition@700000 {
			label = "misc_rw";
			reg = <0x700000 0x600000>;
		};

		/*
		 * The vendor firmware1 slot (0xd00000, 22 MB) is split in two:
		 * a raw kernel FIT at the start, which the bootloader loads from
		 * that fixed address, and UBI for the rest.
		 */
		partition@d00000 {
			label = "kernel";
			reg = <0xd00000 0x400000>;
		};

		partition@1100000 {
			label = "ubi";
			reg = <0x1100000 0x1200000>;
		};

		partition@2300000 {
			label = "firmware2";
			reg = <0x2300000 0x1600000>;
			read-only;
		};

		partition@3900000 {
			label = "bflag";
			reg = <0x3900000 0x600000>;
		};

		partition@3f00000 {
			label = "misc_rw_bak";
			reg = <0x3f00000 0x600000>;
		};

		partition@4500000 {
			label = "misc_isp";
			reg = <0x4500000 0x600000>;
		};

		/* Not part of the vendor layout, filled by uci-defaults */
		partition@4b00000 {
			label = "factory";
			reg = <0x4b00000 0x40000>;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				eeprom_factory_0: eeprom@0 {
					reg = <0x0 0x400>;
				};

				eeprom_factory_8000: eeprom@8000 {
					reg = <0x8000 0x4da8>;
				};

				macaddr_factory_10000: macaddr@10000 {
					compatible = "mac-base";
					reg = <0x10000 0x6>;
					#nvmem-cell-cells = <1>;
				};
			};
		};
	};
};

&pcie {
	status = "okay";
};

&pcie0 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&eeprom_factory_0>, <&macaddr_factory_10000 0>;
		nvmem-cell-names = "eeprom", "mac-address";
		ieee80211-freq-limit = <2400000 2500000>;
	};
};

&pcie1 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&eeprom_factory_8000>, <&macaddr_factory_10000 2>;
		nvmem-cell-names = "eeprom", "mac-address";
		ieee80211-freq-limit = <5000000 6000000>;
	};
};

&gmac0 {
	nvmem-cells = <&macaddr_factory_10000 0>;
	nvmem-cell-names = "mac-address";
};

&switch0 {
	ports {
		port@0 {
			status = "okay";
			label = "wan";
		};

		port@1 {
			status = "okay";
			label = "lan1";
		};

		port@2 {
			status = "okay";
			label = "lan2";
		};

		port@3 {
			status = "okay";
			label = "lan3";
		};

		port@4 {
			status = "okay";
			label = "lan4";
		};
	};
};

&state_default {
	gpio {
		groups = "i2c", "uart3", "jtag", "wdt";
		function = "gpio";
	};
};

#include "mt7621.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "TP-Link Archer C5 v6 INACT";
	compatible = "tplink,archer-c5-v6-inact", "mediatek,mt7621-soc";

	aliases {
		label-mac-device = &gmac0;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	chosen {
		bootargs = "console=ttyS0,115200n8";
	};

	keys {
		compatible = "gpio-keys";

		button-wps {
			label = "wps";
			gpios = <&gpio 10 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
			linux,code = <KEY_WPS_BUTTON>;
		};

		button-reset {
			label = "reset";
			gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-power {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio 4 GPIO_ACTIVE_LOW>;
		};

		led-wan-amber {
			color = <LED_COLOR_ID_AMBER>;
			function = LED_FUNCTION_WAN;
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
		};

		led-lan {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
		};

		led-wifi5g {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			function-enumerator = <5>;
			gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy1tpt";
		};

		led-wifi2g {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			function-enumerator = <2>;
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};

		led-wan-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&gpio 45 GPIO_ACTIVE_LOW>;
		};
	};
	virtual-flash {
    compatible = "mtd-concat";
    devices = <&firmware1 &firmware2>;

    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        partition@0 {
            label = "firmware";
            reg = <0x0 0x2c00000>; // firmware1 + firmware2 size (44 MB)
        };
    };
};
};

/* ---- NAND Flash with NMBM ---- */
&nand {
	status = "okay";

	mediatek,nmbm;
	mediatek,bmt-remap-range = <0x0 0x5800000>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "boot";
			reg = <0x0000000 0x0080000>;
			read-only;
		};

		partition@80000 {
			label = "boot-env";
			reg = <0x0080000 0x0080000>;
		};

		partition@100000 {
			label = "misc_ro";
			reg = <0x0100000 0x0600000>;
			read-only;
		};

		partition@700000 {
			label = "misc_rw";
			reg = <0x0700000 0x0600000>;
		};

		firmware1: partition@d00000 {
			label = "firmware1";
			reg = <0x0d00000 0x1600000>;
			compatible = "denx,uimage";
		};

		firmware2: partition@2300000 {
			label = "firmware2";
			reg = <0x2300000 0x1600000>;
			compatible = "denx,uimage";
		};

		partition@3900000 {
			label = "bflag";
			reg = <0x3900000 0x0600000>;
		};

		partition@3f00000 {
			label = "misc_rw_bak";
			reg = <0x3f00000 0x0600000>;
		};

		partition@4500000 {
			label = "misc_isp";
			reg = <0x4500000 0x0600000>;
		};

		factory: partition@4b00000 {
			label = "factory";
			reg = <0x4b00000 0x0040000>;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				eeprom_radio_0: eeprom@0 {
					reg = <0x0 0x400>;
				};

				eeprom_radio_8000: eeprom@8000 {
					reg = <0x8000 0x4da8>;
				};

				macaddr_factory_4: macaddr@4 {
					reg = <0x10000 0x6>;
				};
			};
		};
	};
};

&pcie {
	status = "okay";
};

&pcie0 {
	status = "okay";

	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		mediatek,mtd-eeprom = <&eeprom_radio_0>;
		ieee80211-freq-limit = <2400000 2500000>;
	};
};

&pcie1 {
	status = "okay";

	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		mediatek,mtd-eeprom = <&eeprom_radio_8000>;
		ieee80211-freq-limit = <5000000 6000000>;
	};
};

&switch0 {
	ports {
		port@0 { status = "okay"; label = "wan"; };
		port@1 { status = "okay"; label = "lan1"; };
		port@2 { status = "okay"; label = "lan2"; };
		port@3 { status = "okay"; label = "lan3"; };
		port@4 { status = "okay"; label = "lan4"; };
	};
};

&state_default {
	gpio {
		groups = "i2c", "uart3", "jtag", "wdt";
		function = "gpio";
	};
};
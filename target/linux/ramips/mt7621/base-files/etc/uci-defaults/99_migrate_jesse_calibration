#!/bin/sh
. /lib/functions.sh

log() {
    echo "$1"
    logger -t "jesse-migration" -p kern.info "$1"
}

perform_jesse_migration() {
    log "Starting Jesse calibration data migration to factory partition"

    if [ ! -c /dev/mtd9 ]; then
        log "Factory partition (mtd9) not found - skipping migration"
        return 1
    fi

    if hexdump -n 512 -C /dev/mtd9 2>/dev/null | grep -q -v "ff ff ff ff"; then
        log "Factory partition already populated - skipping migration"
        return 0
    fi

    if [ ! -c /dev/mtd2 ]; then
        log "Jesse misc_ro partition (mtd2) not found - skipping migration"
        return 1
    fi

    mkdir -p /tmp/misc_ro
    if ! mount -t jffs2 -o ro /dev/mtdblock2 /tmp/misc_ro; then
        log "Failed to mount Jesse misc_ro partition - aborting"
        rmdir /tmp/misc_ro
        return 1
    fi

    # Verify required files
    missing_files=0
    for file in 0x00180000 0x001A0000 0x0014F100 0x0014F1E0; do
        if [ ! -f "/tmp/misc_ro/$file" ]; then
            log "Warning: Jesse file $file not found"
            missing_files=1
        fi
    done

    if [ "$missing_files" = "1" ]; then
        log "Required Jesse files missing - aborting migration"
        umount /tmp/misc_ro
        rmdir /tmp/misc_ro
        return 1
    fi

    log "Creating blank factory image..."
    dd if=/dev/zero bs=1024 count=256 2>/dev/null | tr '\000' '\377' > /tmp/factory.bin || {
        log "Failed to create factory image"
        umount /tmp/misc_ro
        rmdir /tmp/misc_ro
        return 1
    }

    log "Copying calibration data..."
    dd if=/tmp/misc_ro/0x00180000 of=/tmp/factory.bin bs=1 count=512 seek=0 conv=notrunc
    dd if=/tmp/misc_ro/0x001A0000 of=/tmp/factory.bin bs=1 count=1536 seek=32768 conv=notrunc
    dd if=/tmp/misc_ro/0x0014F100 of=/tmp/factory.bin bs=1 count=6 seek=65536 conv=notrunc
    dd if=/tmp/misc_ro/0x0014F1E0 of=/tmp/factory.bin bs=1 count=6 seek=98304 conv=notrunc

    umount /tmp/misc_ro
    rmdir /tmp/misc_ro

    log "Writing factory image to mtd9..."
    mtd unlock factory
    if ! mtd -e factory write /tmp/factory.bin factory; then
        log "ERROR: Failed to write factory partition!"
        rm -f /tmp/factory.bin
        return 1
    fi

    rm -f /tmp/factory.bin
    log "Verifying factory partition..."
    if hexdump -n 512 -C /dev/mtd9 2>/dev/null | grep -q -v "ff ff ff ff"; then
        log "SUCCESS: Calibration data migrated!"

        log "2.4GHz MAC: $(hexdump -s 65536 -n 6 -e '6/1 "%02x:" "\n"' /dev/mtd9 | sed 's/:$//')"
        log "5GHz MAC:   $(hexdump -s 98304 -n 6 -e '6/1 "%02x:" "\n"' /dev/mtd9 | sed 's/:$//')"
        return 0
    else
        log "WARNING: Factory partition appears empty after migration"
        return 1
    fi
}

board=$(board_name)

case "$board" in
    tplink,archer-c5-v6-inact)
        log "Detected TP-Link Archer C5 v6, running migration..."
        perform_jesse_migration
        ;;
    *)
        log "Board $board does not require migration - skipping"
        ;;
esac
